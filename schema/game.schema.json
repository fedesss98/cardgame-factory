{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Factory v1 project",
  "description": "Proposed v1 contract. Cross-reference and gameplay validation are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "contentVersion", "saveCompatibilityVersion", "language", "theme", "assets", "stats", "flags", "cards", "decks", "chapters", "endings", "startChapterId", "fallbackEndingId", "android"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/label"},
    "description": {"type": "string", "maxLength": 4000},
    "contentVersion": {"type": "integer", "minimum": 1},
    "saveCompatibilityVersion": {"type": "integer", "minimum": 1},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "theme": {"$ref": "#/$defs/theme"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "stats": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/stat"}},
    "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}},
    "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/card"}},
    "decks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deck"}},
    "chapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chapter"}},
    "endings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ending"}},
    "startChapterId": {"$ref": "#/$defs/id"},
    "fallbackEndingId": {"$ref": "#/$defs/id"},
    "android": {"$ref": "#/$defs/android"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "theme": {
      "type": "object", "additionalProperties": false,
      "required": ["preset", "background", "surface", "text", "accent", "font"],
      "properties": {
        "preset": {"enum": ["classic", "minimal", "storybook"]},
        "background": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "font": {"enum": ["system-sans", "system-serif", "bundled"]},
        "fontAssetId": {"$ref": "#/$defs/id"},
        "backgroundAssetId": {"$ref": "#/$defs/id"}
      },
      "allOf": [{"if": {"properties": {"font": {"const": "bundled"}}}, "then": {"required": ["fontAssetId"]}, "else": {"not": {"required": ["fontAssetId"]}}}]
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["image", "font"]},
        "path": {"type": "string", "pattern": "^assets/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.(?:png|jpg|jpeg|webp|woff2)$"},
        "credit": {"type": "string", "maxLength": 1000},
        "license": {"type": "string", "maxLength": 1000}
      }
    },
    "stat": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "min", "max", "initial"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/label"},
        "min": {"type": "integer"}, "max": {"type": "integer"}, "initial": {"type": "integer"},
        "iconAssetId": {"$ref": "#/$defs/id"}
      }
    },
    "flag": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "initial", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/label"},
        "initial": {"type": "boolean"}, "scope": {"enum": ["run", "persistent"]}
      }
    },
    "comparison": {"enum": ["eq", "lt", "lte", "gt", "gte"]},
    "predicate": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "statId", "op", "value"], "properties": {"kind": {"const": "stat"}, "statId": {"$ref": "#/$defs/id"}, "op": {"$ref": "#/$defs/comparison"}, "value": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "flagId", "value"], "properties": {"kind": {"const": "flag"}, "flagId": {"$ref": "#/$defs/id"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "scope", "op", "value"], "properties": {"kind": {"const": "turn"}, "scope": {"enum": ["run", "chapter"]}, "op": {"$ref": "#/$defs/comparison"}, "value": {"type": "integer", "minimum": 0}}}
      ]
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": {"enum": ["all", "any"]},
        "rules": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/predicate"}}
      }
    },
    "effect": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "statId", "delta"], "properties": {"kind": {"const": "statDelta"}, "statId": {"$ref": "#/$defs/id"}, "delta": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "flagId", "value"], "properties": {"kind": {"const": "setFlag"}, "flagId": {"$ref": "#/$defs/id"}, "value": {"type": "boolean"}}}
      ]
    },
    "effects": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/effect"}},
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["label", "effects"],
      "properties": {
        "label": {"$ref": "#/$defs/label"}, "effects": {"$ref": "#/$defs/effects"},
        "followUpCardId": {"$ref": "#/$defs/id"}
      }
    },
    "card": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "character", "text", "imageAssetId", "imageAlt", "left", "right", "repeat"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "character": {"$ref": "#/$defs/label"},
        "text": {"$ref": "#/$defs/text"}, "imageAssetId": {"$ref": "#/$defs/id"},
        "imageAlt": {"type": "string", "maxLength": 500},
        "left": {"$ref": "#/$defs/choice"}, "right": {"$ref": "#/$defs/choice"},
        "when": {"$ref": "#/$defs/condition"}, "tags": {"$ref": "#/$defs/ids"},
        "repeat": {"enum": ["unlimited", "oncePerChapter", "oncePerRun"]}
      }
    },
    "deckEntry": {
      "type": "object", "additionalProperties": false, "required": ["cardId", "weight"],
      "properties": {"cardId": {"$ref": "#/$defs/id"}, "weight": {"type": "integer", "minimum": 1, "maximum": 10000}}
    },
    "deck": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "mode", "cards"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/label"},
        "mode": {"enum": ["weighted", "ordered"]},
        "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deckEntry"}}
      }
    },
    "activeDeck": {
      "type": "object", "additionalProperties": false, "required": ["deckId", "weight"],
      "properties": {
        "deckId": {"$ref": "#/$defs/id"}, "weight": {"type": "integer", "minimum": 1, "maximum": 10000},
        "when": {"$ref": "#/$defs/condition"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["when", "toChapterId"],
      "properties": {"when": {"$ref": "#/$defs/condition"}, "toChapterId": {"$ref": "#/$defs/id"}}
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "onEnter", "decks", "transitions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/label"},
        "onEnter": {"$ref": "#/$defs/effects"},
        "decks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activeDeck"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
      }
    },
    "ending": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "text", "priority"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/label"}, "text": {"$ref": "#/$defs/text"},
        "priority": {"type": "integer"}, "when": {"$ref": "#/$defs/condition"},
        "imageAssetId": {"$ref": "#/$defs/id"}
      }
    },
    "android": {
      "type": "object", "additionalProperties": false, "required": ["applicationId", "displayName", "versionName", "versionCode"],
      "properties": {
        "applicationId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$"},
        "displayName": {"$ref": "#/$defs/label"},
        "versionName": {"type": "string", "minLength": 1, "maxLength": 50},
        "versionCode": {"type": "integer", "minimum": 1, "maximum": 2100000000},
        "iconAssetId": {"$ref": "#/$defs/id"}
      }
    }
  }
}
